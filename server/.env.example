# Copy this file to .env — the real .env is git-ignored because it holds secrets.
#
#   cp .env.example .env
#
# The values below are DEVELOPMENT DEFAULTS. They are safe on your laptop and
# unsafe anywhere else. In production the server refuses to start if it finds
# a placeholder or a secret shorter than 32 characters (see src/config/env.ts).

# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory_dev_password@localhost:5432/inventory?schema=public"

# ---------------------------------------------------------------------------
# Auth secrets
#
# These two strings sign every login token. Anyone who knows them can forge a
# session as any user in any company, so they must be long, random, DIFFERENT
# from each other, and never committed anywhere.
#
# Generate a fresh value for each (run twice):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Do NOT paste production secrets into this file, a chat window, a ticket, or
# a commit. Set them directly in the hosting provider's environment settings.
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-not-for-production-replace-me
JWT_REFRESH_SECRET=dev-only-not-for-production-replace-me-too
