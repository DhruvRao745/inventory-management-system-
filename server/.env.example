# Copy this file to .env — the real .env is git-ignored because it holds secrets.

# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory_dev_password@localhost:5432/inventory?schema=public"

# Auth — generate long random strings for production!
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
