{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "description": "Inventory API — Express + TypeScript + Prisma",
  "main": "dist/index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "pretest": "cross-env DATABASE_URL=postgresql://inventory:inventory_dev_password@localhost:5432/inventory_test prisma db push --skip-generate",
    "test": "cross-env DATABASE_URL=postgresql://inventory:inventory_dev_password@localhost:5432/inventory_test JWT_SECRET=test-only-secret JWT_REFRESH_SECRET=test-only-refresh vitest run",
    "test:watch": "cross-env DATABASE_URL=postgresql://inventory:inventory_dev_password@localhost:5432/inventory_test JWT_SECRET=test-only-secret JWT_REFRESH_SECRET=test-only-refresh vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
