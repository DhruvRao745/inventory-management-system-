// ============================================================
// Inventory — multi-tenant database schema
//
// THE ONE RULE: every model except Company carries `companyId`.
// A company (our paying customer) can only ever see rows with
// its own companyId. This is what makes one codebase safely
// serve many businesses.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// TENANT
// ------------------------------------------------------------

/// One customer business. Everything else hangs off this.
model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("INR") // ISO code: INR, USD, EUR...
  // Business details — shown on invoices (the "From" block). All optional so
  // existing companies keep working; the invoice simply omits blank lines.
  address   String? // full business address block
  phone     String?
  email     String?
  gstin        String? // GST registration number (India)
  pan          String? // PAN — the business tax ID
  /// The seller's state, as a GST state code ("27" Maharashtra, "29" Karnataka).
  ///
  /// This is what decides CGST+SGST vs IGST on every invoice: GST splits by
  /// WHERE THE CUSTOMER IS relative to the seller, not by what is being sold.
  /// Without it the system cannot tell an intra-state sale from an inter-state
  /// one, and no amount of rate configuration will fix that.
  stateCode    String?
  sealText     String? // one line inside the round stamp, e.g. "For Demo Traders"
  invoiceTerms String? // terms & conditions printed on invoices (one per line)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  locations      Location[]
  categories     Category[]
  products       Product[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  customers      Customer[]
  inventoryBatches InventoryBatch[]
  payments       Payment[]
  salesReturns   SalesReturn[]
  goodsReceipts  GoodsReceipt[]
  supplierReturns SupplierReturn[]
  productLocationSettings ProductLocationSetting[]
  stockCounts    StockCount[]
  stockReservations StockReservation[]
  sessions          Session[]
  auditLogs         AuditLog[]
}

// ------------------------------------------------------------
// PEOPLE & ACCESS
// ------------------------------------------------------------

enum Role {
  ADMIN   // full control incl. settings & users
  MANAGER // manage products, approve adjustments
  STAFF   // record stock in/out
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String
  passwordHash String   // NEVER the password itself — bcrypt hash only
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  stockMovements StockMovement[] // movements this user recorded
  purchaseOrders PurchaseOrder[] // POs this user created
  invoices       Invoice[]       // invoices this user created
  payments       Payment[]       // payments this user recorded
  salesReturnsRequested SalesReturn[] @relation("ReturnRequestedBy")
  salesReturnsApproved  SalesReturn[] @relation("ReturnApprovedBy")
  salesReturnsReceived  SalesReturn[] @relation("ReturnReceivedBy")
  goodsReceipts         GoodsReceipt[]
  supplierReturns       SupplierReturn[]
  stockCountsStarted    StockCount[] @relation("CountStartedBy")
  stockCountsCompleted  StockCount[] @relation("CountCompletedBy")
  stockReservations     StockReservation[]
  sessions              Session[]
  auditLogs             AuditLog[]

  // Same email may exist at two different companies,
  // but only once within one company:
  @@unique([companyId, email])
  @@index([companyId])
}

// ------------------------------------------------------------
// AUDIT LOG (P2-6)
// ------------------------------------------------------------

/// One recorded action: who did what, to which thing, when.
///
/// WHY A TABLE, WHEN /api/audit ALREADY WORKS
///
/// The existing activity feed INFERS history from tables that happen to have
/// timestamps — products, POs, movements. That is genuinely useful and it works
/// retroactively, so it is kept. But inference can only see what still exists,
/// and only in its current state. It cannot answer:
///
///   • who signed in, from where, and who failed to
///   • that a price went from ₹50 to ₹500 last Tuesday, and who moved it
///   • that a supplier was deactivated, by whom
///   • that someone was promoted from STAFF to ADMIN
///
/// Those are exactly the events an audit exists for, and none of them leave a
/// trace in the row's final state. So this table records them as they happen.
///
/// WHAT IS DELIBERATELY NOT LOGGED HERE
///
/// Stock movements. The ledger is already append-only and never edited — it IS
/// an audit trail, and a better one than this could be. Logging every movement
/// again would double writes on the hottest path in the system and bury the
/// dozen entries that matter under thousands that were already recorded.
///
/// WHY `before` AND `after` ARE JSON
///
/// The alternative — a column per field — cannot describe a schema that keeps
/// changing, and every new field would need a migration to become auditable.
/// JSON costs queryability, which is the right trade: this is read by humans
/// investigating one incident, not aggregated across millions of rows.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String

  /// Nullable ON PURPOSE. A FAILED LOGIN has no authenticated user — and a
  /// failed login is one of the most important things here, because a burst of
  /// them is what an attack looks like from the inside.
  userId    String?
  /// The email attempted, kept even when userId is null. Without it a failed
  /// login records that *somebody* failed, which is useless.
  actorEmail String?

  /// What happened: "login", "login.failed", "product.update",
  /// "payment.record", "invoice.cancel", "user.role_change", "stock.reclassify".
  action    String
  /// Which kind of thing: "user", "product", "invoice", "payment"...
  entity    String
  entityId  String?
  /// Human-readable summary, so a reader doesn't have to parse JSON to grasp
  /// what happened.
  summary   String?

  /// Field values before and after, where a change makes that meaningful.
  before    Json?
  after     Json?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  // The three ways this is actually read: recent activity, one entity's
  // history, one person's actions.
  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([companyId, userId, createdAt])
  @@index([companyId, action, createdAt])
}

// ------------------------------------------------------------
// SESSIONS (P2-5)
// ------------------------------------------------------------

/// One signed-in device.
///
/// WHY THIS TABLE EXISTS
///
/// Before it, a refresh token was a signed JWT and nothing more. The server
/// checked the signature and the expiry — it had no record that the token
/// existed, so it had no way to say "not any more".
///
/// Three consequences, all bad:
///   • Logout was a client-side illusion. It cleared localStorage; a copy of
///     the token taken beforehand kept working for the full 30 days.
///   • A stolen token could not be revoked. Not by logging out, not by
///     changing password. The only remedy was rotating JWT_REFRESH_SECRET,
///     which signs out every user on every device.
///   • Nobody could see where they were signed in.
///
/// WHY ONLY A HASH IS STORED
///
/// PRD §15: "Store only secure token representations where appropriate."
/// `tokenHash` is SHA-256 of the refresh token; the token itself is never
/// written down. If this table leaks, the hashes are useless to an attacker.
/// Storing raw tokens would make a database dump a set of 30-day master keys
/// to every account in the system — the same reasoning as passwordHash.
///
/// SHA-256 rather than bcrypt on purpose: a refresh token is 256 bits of
/// server-generated randomness, not a human-chosen password. There is nothing
/// to brute-force, so the slow hashing bcrypt exists for buys nothing — and
/// this is verified on every token refresh, where speed matters.
model Session {
  id        String   @id @default(cuid())
  userId    String
  companyId String

  /// SHA-256 of the refresh token. Unique so a replay can be spotted.
  tokenHash String   @unique

  /// Sessions born of one login share a family id (P2-5).
  ///
  /// Rotation issues a new token on every refresh and retires the old one.
  /// If a RETIRED token is ever presented again, only two things can explain
  /// it: the token was stolen and replayed, or a legitimate client lost the
  /// response and retried. Neither is safe to wave through, so the whole
  /// family is revoked and everyone re-authenticates.
  familyId  String

  /// Free-text device description from the User-Agent. For the user's benefit
  /// only — trivially spoofed, so it is never used for any security decision.
  userAgent String?
  ipAddress String?

  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  /// Set when this token is rotated away, revoked, or logged out.
  revokedAt   DateTime?
  /// Why it ended — "logout", "rotated", "revoked", "reuse-detected",
  /// "password-change". Kept because "my session ended and I don't know why"
  /// is otherwise unanswerable.
  revokedReason String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// PLACES
// ------------------------------------------------------------

/// Warehouse, shop, or branch. Single-location companies
/// simply have one row here (created automatically at signup).
model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  stockMovements StockMovement[]
  invoices       Invoice[]
  inventoryBatches InventoryBatch[]
  goodsReceipts  GoodsReceipt[]
  supplierReturns SupplierReturn[]
  productSettings ProductLocationSetting[]
  stockCounts    StockCount[]
  stockReservations StockReservation[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ------------------------------------------------------------
// PARTNERS (who we buy from)
// ------------------------------------------------------------

/// A vendor we purchase stock from. Master data for Phase 2's
/// purchase orders; useful on its own as a contact book.
model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company         @relation(fields: [companyId], references: [id])
  purchaseOrders   PurchaseOrder[]
  preferredProducts Product[] // products that name this supplier as preferred
  supplierReturns  SupplierReturn[]
  locationPreferences ProductLocationSetting[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ------------------------------------------------------------
// PURCHASE ORDERS (buying stock — Phase 2)
// ------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT     // being built; editable
  ORDERED   // sent to supplier; locked, awaiting delivery
  PARTIAL   // some items received, some still pending
  RECEIVED  // every line fully received into stock
  CANCELLED // called off
}

/// A purchase order: what we're buying from one supplier. The number is
/// sequential PER COMPANY (PO-0001, PO-0002...), enforced by the unique
/// index; the service assigns the next value inside a transaction.
model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String
  supplierId   String
  number       Int // per-company sequence; display as PO-0001
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  expectedDate DateTime? // when we expect delivery (optional)
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, supplierId])
}

/// One line of a purchase order: a product, how many we're ordering, and
/// the agreed unit cost. Deleted/replaced freely while the PO is a DRAFT.
model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal @db.Decimal(18, 4) // ordered quantity (always positive)
  receivedQty     Decimal @default(0) @db.Decimal(18, 4) // how much has arrived so far
  unitCost        Decimal @db.Decimal(12, 2) // agreed price per unit

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

// ------------------------------------------------------------
// GOODS RECEIPT (P1-7)
// ------------------------------------------------------------

/// A delivery arriving against a purchase order.
///
/// WHY THIS EXISTS: receiving used to happen inline on the PO, leaving no
/// document. You could not say "this pallet arrived on Tuesday, three units
/// were broken, and the supplier charged more than quoted" — the only trace
/// was a bumped counter.
model GoodsReceipt {
  id              String   @id @default(cuid())
  companyId       String
  number          Int // per-company sequence; display as GRN-0001
  purchaseOrderId String
  locationId      String
  notes           String?
  receivedById    String
  createdAt       DateTime @default(now())

  company       Company            @relation(fields: [companyId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  receivedBy    User               @relation(fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([purchaseOrderId])
}

/// One product on a delivery.
model GoodsReceiptLine {
  id                  String  @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  /// Goods we took in. ONLY this quantity enters stock.
  acceptedQty         Decimal @db.Decimal(18, 4)
  /// Goods that turned up but were refused — broken, wrong item, short-dated.
  /// Recorded so the supplier can be chased, but never becomes inventory, and
  /// never counts towards fulfilling the order.
  rejectedQty         Decimal @default(0) @db.Decimal(18, 4)
  /// What we were ACTUALLY charged, which is not always what was quoted.
  /// This is the figure that feeds the weighted average — inventory is worth
  /// what you paid, not what you expected to pay.
  actualUnitCost      Decimal @db.Decimal(12, 2)
  rejectReason        String?
  batchNumber         String?
  manufactureDate     DateTime?
  expiryDate          DateTime?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  supplierReturnLines SupplierReturnLine[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

// ------------------------------------------------------------
// SUPPLIER RETURNS (P1-7)
// ------------------------------------------------------------

enum SupplierReturnStatus {
  DRAFT     // being prepared; nothing has moved
  SENT      // goods have gone back — THIS is when stock decreases
  COMPLETED // supplier acknowledged / credited us
  CANCELLED
}

/// Sending goods back to a supplier.
///
/// Mirrors SalesReturn, in the opposite direction. Where possible it points at
/// the goods receipt the items arrived on, so "which delivery was this from?"
/// has an answer — PRD §10 asks for that reference explicitly.
model SupplierReturn {
  id             String               @id @default(cuid())
  companyId      String
  number         Int // per-company sequence; display as SRT-0001
  supplierId     String
  locationId     String
  /// The delivery these goods came in on, where we know it.
  goodsReceiptId String?
  status         SupplierReturnStatus @default(DRAFT)
  reason         String?
  notes          String?
  createdById    String
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  location  Location             @relation(fields: [locationId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  lines     SupplierReturnLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([supplierId])
}

model SupplierReturnLine {
  id                 String  @id @default(cuid())
  supplierReturnId   String
  productId          String
  quantity           Decimal @db.Decimal(18, 4)
  unitCost           Decimal @db.Decimal(12, 2)
  /// Which receipt line these units arrived on, where known.
  goodsReceiptLineId String?
  notes              String?

  supplierReturn   SupplierReturn    @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  @@index([supplierReturnId])
}

// ------------------------------------------------------------
// INVOICES (selling stock — Phase F4)
// ------------------------------------------------------------

/// Which tax regime an invoice was raised under (P2-3). See Invoice.taxMode.
enum TaxMode {
  FLAT // legacy: one taxRate for the whole invoice
  GST  // per-line CGST/SGST/IGST
}

/// Intra-state (CGST+SGST) or inter-state (IGST).
///
/// Decided by comparing the seller's state with the place of supply. Same
/// goods and same rate produce a different SPLIT depending on this — and the
/// split matters because the halves go to different governments.
enum SupplyType {
  INTRA_STATE // buyer in the seller's state → CGST + SGST
  INTER_STATE // buyer elsewhere            → IGST
}

enum InvoiceStatus {
  DRAFT     // being built; editable
  ISSUED    // finalised; stock deducted via SALE movements
  PAID      // customer has paid
  CANCELLED // called off (only before issuing)
}

/// A customer invoice. Number is sequential per company (INV-0001...).
/// Issuing deducts stock from `locationId` by writing SALE movements.
model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  number          Int // per-company sequence; display as INV-0001
  status          InvoiceStatus @default(DRAFT)
  customerId      String? // optional link to a saved customer (A1)
  customerName    String // snapshot — always kept even if unlinked
  customerPhone   String?
  customerAddress String?
  customerGstin   String? // buyer's GST — snapshot, for B2B invoices
  notes           String?
  taxRate         Decimal? @db.Decimal(5, 2) // % applied after discount (A3)
  discount        Decimal? @db.Decimal(12, 2) // flat amount off the subtotal (A3)

  // --- GST (P2-3) --------------------------------------------------------
  //
  // `taxMode` is the load-bearing field. It records WHICH REGIME an invoice
  // was raised under, so nothing ever has to infer it from whether other
  // columns happen to be null:
  //
  //   FLAT — every invoice created before P2-3. One `taxRate` on the whole
  //          invoice. Read from stored values, NEVER recomputed.
  //   GST  — per-line CGST/SGST/IGST, computed at issue and stamped.
  //
  // Without this flag, "no GST columns" and "GST of zero" are the same thing
  // on the wire, and a nil-rated invoice would be indistinguishable from a
  // legacy one.
  taxMode         TaxMode  @default(FLAT)
  /// Buyer's state code at the time of invoicing — the place of supply.
  /// Snapshotted, because a customer who later moves state must not
  /// retroactively change the tax treatment of past sales.
  placeOfSupply   String?
  supplyType      SupplyType?
  locationId      String // where the sold stock comes from
  issuedAt        DateTime? // when it moved to ISSUED
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company   Company       @relation(fields: [companyId], references: [id])
  location  Location      @relation(fields: [locationId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]
  returns   SalesReturn[]

  @@unique([companyId, number])
  @@index([companyId])
}

// ------------------------------------------------------------
// PAYMENTS (P1-5)
// ------------------------------------------------------------

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

/// Money actually received against an invoice.
///
/// WHY THIS EXISTS: before P1-5 "paid" was a status someone flipped, with no
/// record of how much arrived, when, or by what means. A half-paid invoice
/// could not be represented at all, and "who still owes us money?" had no
/// answer the system could give.
///
/// Payment state is now DERIVED from these rows (PRD §8: "Do not infer payment
/// state only from a status field"). `Invoice.status` still shows PAID, but as
/// a CONSEQUENCE of the payments summing to the total — never as the source of
/// truth.
model Payment {
  id          String        @id @default(cuid())
  companyId   String
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  /// When the money actually arrived, which is not always when it was keyed
  /// in — a cheque banked on Friday may only be recorded on Monday.
  paymentDate DateTime      @default(now())
  reference   String? // UPI ref, cheque number, transaction id
  notes       String?
  createdById String
  createdAt   DateTime      @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, paymentDate])
}

/// A saved customer — like a supplier, but for who we sell to (A1).
model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  /// Buyer's GST registration, for B2B invoices.
  gstin     String?
  /// Buyer's state code — the "place of supply" for goods (P2-3).
  stateCode String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  invoices Invoice[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// One line: a product, quantity sold, and the price charged per unit.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(12, 2)

  // --- GST, stamped at write time (P2-3) --------------------------------
  //
  // Every one of these is a SNAPSHOT, for the same reason costAtTime is in
  // P1-3: an issued invoice is a legal document. If the government raises the
  // rate on tinned fish in April, an invoice from March must still show the
  // March tax. Recomputing tax on read would silently rewrite financial
  // history — and the customer's copy would stop matching ours.
  //
  // NULL on every invoice created before P2-3. Those are read from the
  // invoice's flat `taxRate` instead; `Invoice.taxMode` says which regime
  // applies, so nothing ever has to guess.
  hsnCode      String?  // HSN/SAC code as it stood when invoiced
  gstRate      Decimal? @db.Decimal(5, 2)  // total GST % for this line
  taxableValue Decimal? @db.Decimal(12, 2) // line value tax is charged on
  cgstAmount   Decimal? @db.Decimal(12, 2) // central — intra-state only
  sgstAmount   Decimal? @db.Decimal(12, 2) // state — intra-state only
  igstAmount   Decimal? @db.Decimal(12, 2) // integrated — inter-state only

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  returnLines SalesReturnLine[]

  @@index([invoiceId])
}

// ------------------------------------------------------------
// SALES RETURNS (P1-6)
// ------------------------------------------------------------

enum SalesReturnStatus {
  REQUESTED // customer has asked; nothing has moved
  APPROVED  // we've agreed to take it back
  RECEIVED  // goods are physically here — THIS is when stock moves
  REFUNDED  // money returned to the customer
  CANCELLED // called off before receiving
}

/// What condition the goods came back in.
///
/// This is the field that decides whether stock goes back on the shelf.
/// PRD §9: "Only sellable returned stock should increase available stock."
enum ReturnCondition {
  SELLABLE   // fine — can be sold again
  DAMAGED    // broken; cannot be sold
  QUARANTINE // needs inspection before anyone decides
}

/// A customer sending goods back, against a specific invoice.
///
/// WHY THIS EXISTS: before P1-6 the only way to reverse a sale was to cancel
/// the whole invoice, which restored every line in full. A customer returning
/// 2 of 10 items had no representation, and goods coming back broken were
/// silently added to sellable stock — the shop would confidently try to sell
/// them again.
model SalesReturn {
  id        String            @id @default(cuid())
  companyId String
  number    Int // per-company sequence; display as RET-0001
  invoiceId String
  status    SalesReturnStatus @default(REQUESTED)
  reason    String?
  /// What we agreed to refund. Recorded here as the decision; paying it back
  /// is a separate act (see the note in return.service.ts).
  refundAmount Decimal?       @db.Decimal(12, 2)
  notes     String?

  requestedById String
  approvedById  String?
  receivedById  String?
  approvedAt    DateTime?
  receivedAt    DateTime?
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  requestedBy User              @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?             @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  receivedBy  User?             @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  lines       SalesReturnLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([invoiceId])
}

/// One line of a return: which invoice line, how much, and in what state.
model SalesReturnLine {
  id            String          @id @default(cuid())
  salesReturnId String
  invoiceLineId String
  productId     String
  quantity      Decimal         @db.Decimal(18, 4)
  condition     ReturnCondition @default(SELLABLE)
  /// Whether these units go back into sellable stock.
  ///
  /// A decision, but a constrained one: you may decline to restock sellable
  /// goods, but you can NEVER restock damaged or quarantined ones. Enforced in
  /// the service and by a CHECK constraint.
  restock       Boolean         @default(true)
  notes         String?

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([salesReturnId])
  @@index([invoiceLineId])
}

// ------------------------------------------------------------
// WHAT WE STOCK
// ------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id                String   @id @default(cuid())
  companyId         String
  sku               String   // "stock keeping unit" — the code printed on the label
  barcode           String?  // scannable code (Code128); generated, unique per company (B1)
  name              String
  description       String?
  hsnCode           String?  // HSN/SAC tax code, printed per line on GST invoices
  categoryId          String?
  preferredSupplierId String? // usual vendor for this item (Phase 4)
  /// The unit stock is COUNTED in — pcs, kg, litre, metre.
  unit              String   @default("pcs")
  /// How many decimal places this product's quantities may have (P1-2).
  /// 0 = whole units only (you cannot sell half a stapler).
  /// 3 = grams-level precision on a kg-stocked product.
  /// Enforced server-side against every quantity, so nobody can book
  /// 0.333333 kg and leave un-sellable dust in the ledger forever.
  precision         Int      @default(0)
  /// Optional purchase-pack unit: "box". Purely a label.
  packUnit          String?
  /// How many `unit` are in one `packUnit` — 1 box = 12 pieces → 12.
  /// Deliberately a single factor, not a full ERP unit system (PRD §6).
  unitsPerPack      Decimal? @db.Decimal(18, 4)
  /// The list/reference cost someone typed in. NOT accounting-grade — it is
  /// whatever was last entered, and changing it rewrites no history.
  /// For valuation and profit, use `avgCost` below.
  costPrice         Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0) @db.Decimal(12, 2) // what the customer pays

  // --- Weighted-average costing (P1-3) ------------------------------------
  /// Running weighted-average cost per unit, company-wide for this product.
  ///   New Average = Total Inventory Value / Total Inventory Quantity
  /// Six decimal places, not two: ₹100 across 3 units is 33.333333, and
  /// rounding to paise on every receipt compounds into real drift.
  /// GST rate for this product, as a percentage (5, 12, 18, 28...).
  ///
  /// Lives on the product because rate follows the GOODS, not the invoice —
  /// a shop selling both books (nil-rated) and electronics (28%) cannot be
  /// described by one invoice-level rate. Copied onto each invoice line at
  /// write time, so changing it here never alters an invoice already issued.
  gstRate           Decimal? @db.Decimal(5, 2)
  avgCost           Decimal  @default(0) @db.Decimal(18, 6)
  /// Total value of stock on hand for this product, company-wide.
  /// Maintained alongside avgCost so the average never has to be recomputed
  /// by replaying the whole ledger.
  stockValue        Decimal  @default(0) @db.Decimal(18, 4)
  /// Alert when stock falls to/below this. Decimal since P1-2 — a 0.5 kg
  /// threshold is as reasonable as a 5-piece one.
  lowStockThreshold Decimal  @default(0) @db.Decimal(18, 4)
  tracksBatch       Boolean  @default(false) // if true, stock is tracked per batch (P1-1)
  /// How outgoing stock picks batches. FEFO (nearest expiry first) is right for
  /// anything perishable; FIFO (oldest received first) for non-expiring goods.
  /// Only consulted when tracksBatch is true.
  batchStrategy     BatchStrategy @default(FEFO)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  preferredSupplier  Supplier?           @relation(fields: [preferredSupplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       InvoiceLine[]
  inventoryBatches   InventoryBatch[]
  salesReturnLines   SalesReturnLine[]
  stockCountItems    StockCountItem[]
  goodsReceiptLines  GoodsReceiptLine[]
  supplierReturnLines SupplierReturnLine[]
  locationSettings   ProductLocationSetting[]
  stockReservations  StockReservation[]

  // SKU must be unique within a company (two companies can both have "SKU-001")
  @@unique([companyId, sku])
  // Barcode also unique per company (NULLs allowed — many products may lack one)
  @@unique([companyId, barcode])
  @@index([companyId])
}

// ------------------------------------------------------------
// BATCHES (P1-1)
// ------------------------------------------------------------

/// Which batch outgoing stock is taken from first.
enum BatchStrategy {
  FEFO // First Expired, First Out — nearest expiry goes first (perishables)
  FIFO // First In, First Out — oldest receipt goes first (non-expiring)
}

/// One physical lot of one product at one location.
///
/// The ledger answers "how many do we have?"; this answers "how many of WHICH
/// ones, and when do they expire?". `remainingQuantity` is the live figure,
/// decremented as stock is consumed — the one place in the system where a
/// quantity is stored rather than summed, because a batch's identity is what
/// makes it meaningful.
///
/// That storing is exactly the read-then-write pattern P0 exists to guard, so
/// every mutation happens inside the `lockStock` advisory lock, which is keyed
/// on (companyId, productId, locationId) — a batch's identity minus its number.
///
/// Quantities are Decimal(18,4) from birth so the P1-2 decimal migration never
/// has to touch this table.
model InventoryBatch {
  id                String    @id @default(cuid())
  companyId         String
  productId         String
  locationId        String
  batchNumber       String
  manufactureDate   DateTime?
  expiryDate        DateTime? // null = does not expire
  unitCost          Decimal   @default(0) @db.Decimal(12, 2) // cost of THIS lot
  receivedQuantity  Decimal   @db.Decimal(18, 4) // as first received; never changes
  remainingQuantity Decimal   @db.Decimal(18, 4) // what's left right now
  /// Condition of THIS lot (P2-2), mirroring the movement that created it.
  ///
  /// A batch needs its own copy because FEFO reads batches, not movements: an
  /// allocator that only knew movement statuses would happily pick a
  /// quarantined lot to fill an order, since the lot looks like ordinary stock
  /// from the batch table's point of view.
  status            StockStatus @default(AVAILABLE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company     Company              @relation(fields: [companyId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  location    Location             @relation(fields: [locationId], references: [id])
  allocations StockMovementBatch[]
  countItems  StockCountItem[]

  // One batch number means one lot, per product per location per company —
  // and per CONDITION since P2-2, because "B1, available" and "B1, damaged"
  // are separate holdings that must never be merged into one row.
  @@unique([companyId, productId, locationId, batchNumber, status])
  // The FEFO scan: "oldest-expiring SELLABLE stock of this product here."
  @@index([companyId, productId, locationId, status, expiryDate])
  @@index([companyId, productId, locationId, expiryDate])
  @@index([companyId])
}

/// Which batches one movement drew from — the split behind a single event.
///
/// Selling 120 across a 100-unit and an 80-unit batch stays ONE SALE movement
/// (so SUM(quantity) is still the stock level, and the existing API shape
/// doesn't change); the 100/20 split is recorded here.
model StockMovementBatch {
  id         String  @id @default(cuid())
  movementId String
  batchId    String
  /// Signed, matching its parent movement: negative when consumed, positive
  /// when added. So SUM(quantity) here per batch mirrors the batch's history.
  quantity   Decimal @db.Decimal(18, 4)

  movement StockMovement  @relation(fields: [movementId], references: [id], onDelete: Cascade)
  batch    InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([movementId])
  @@index([batchId])
}

// ------------------------------------------------------------
// STOCK COUNTING (P1-9)
// ------------------------------------------------------------

enum StockCountStatus {
  OPEN      // sheet prepared; expected quantities snapshotted
  COUNTING  // staff are walking the shelves entering figures
  REVIEW    // everything counted; someone must look at the variances
  COMPLETED // adjustments written to the ledger
  CANCELLED
}

/// A physical stocktake at one location.
///
/// THE RULE (PRD §12): "Never silently overwrite system stock."
///
/// Completing a count does NOT set the ledger to the counted figure. It writes
/// ADJUSTMENT movements for the variance, so the correction is an event with a
/// person and a time attached, and the ledger remains the single source of
/// truth. A stocktake that quietly rewrote the numbers would destroy the audit
/// trail that makes the ledger worth having.
model StockCount {
  id         String           @id @default(cuid())
  companyId  String
  number     Int // per-company sequence; display as CNT-0001
  locationId String
  status     StockCountStatus @default(OPEN)
  notes      String?

  startedById   String
  completedById String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  location    Location         @relation(fields: [locationId], references: [id])
  startedBy   User             @relation("CountStartedBy", fields: [startedById], references: [id])
  completedBy User?            @relation("CountCompletedBy", fields: [completedById], references: [id])
  items       StockCountItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, locationId])
}

/// One line on the count sheet.
model StockCountItem {
  id           String  @id @default(cuid())
  stockCountId String
  productId    String
  /// For batch-tracked products, which lot is being counted.
  batchId      String?

  /// What the system believed when the sheet was prepared. Snapshotted so the
  /// variance stays meaningful even if stock moves while people are counting.
  expectedQuantity Decimal  @db.Decimal(18, 4)
  /// What was physically found. Null until someone counts it — which is
  /// different from counting zero, and the difference matters.
  countedQuantity  Decimal? @db.Decimal(18, 4)
  notes            String?

  /// NOTE: `variance` is deliberately NOT stored, though PRD §12 lists it.
  /// It is exactly `countedQuantity − expectedQuantity` — two columns in the
  /// same row. Storing it would add a third value that can disagree with the
  /// two it's derived from. The API computes it on read.
  stockCount StockCount      @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  batch      InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([stockCountId])
}

// ------------------------------------------------------------
// REORDER SETTINGS PER LOCATION (P1-8)
// ------------------------------------------------------------

/// Reorder rules for one product at ONE location.
///
/// WHY THIS EXISTS (PRD §11): `Product.lowStockThreshold` is a single
/// company-wide number, and the reorder report summed stock across every
/// location before comparing against it. So:
///
///     Warehouse A: 2 units    Warehouse B: 100 units    threshold: 10
///
/// ...totalled 102, sailed past the threshold, and raised no warning — while
/// Warehouse A sat nearly empty and the staff there had nothing to sell.
/// A company total tells you nothing about the shelf someone is standing at.
///
/// Every field is OPTIONAL and falls back to the product-level default, so
/// products that never set a per-location rule behave exactly as before.
model ProductLocationSetting {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String

  /// Reorder when stock here falls to/below this. Falls back to
  /// Product.lowStockThreshold.
  minQuantity     Decimal? @db.Decimal(18, 4)
  /// What a full shelf looks like here. Used to size the suggested order:
  /// top back up to max rather than guessing a multiple of the minimum.
  maxQuantity     Decimal? @db.Decimal(18, 4)
  /// Fixed order size, where the supplier only sells in set amounts
  /// (a pallet, a case). Overrides the max-based calculation.
  reorderQuantity Decimal? @db.Decimal(18, 4)
  /// Who to buy from FOR THIS LOCATION — a northern warehouse may have a
  /// different local supplier than a southern one. Falls back to
  /// Product.preferredSupplierId.
  preferredSupplierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company   @relation(fields: [companyId], references: [id])
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier? @relation(fields: [preferredSupplierId], references: [id])

  @@unique([companyId, productId, locationId])
  @@index([companyId])
  @@index([companyId, locationId])
}

// ------------------------------------------------------------
// RESERVATIONS (P2-1)
// ------------------------------------------------------------

/// Why a reservation is NOT a StockMovement.
///
/// PRD §13: "A future reservation must not immediately subtract physical
/// stock." A reservation is a PROMISE, not an event. The goods are still on
/// the shelf; someone has simply spoken for them.
///
/// Putting a promise in the ledger would corrupt everything downstream: stock
/// on hand would drop for goods nobody has taken, valuation would fall for
/// stock the company still owns, and a stocktake would report a variance
/// against goods physically present. So reservations live in their own table
/// and the ledger stays a record of things that actually happened.
///
///     On hand   = SUM(movements)              — what is physically here
///     Reserved  = SUM(active reservations)    — what is spoken for
///     Available = On hand − Reserved          — what may still be sold
enum ReservationStatus {
  ACTIVE    // holding stock right now
  CONSUMED  // became a real movement (the invoice was issued)
  RELEASED  // cancelled or expired — no longer holds anything
}

/// One promise: N units of a product at a location, held for something.
model StockReservation {
  id         String            @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  /// Always POSITIVE. A reservation reduces availability by its own size;
  /// making it signed would invite a "negative reservation" that silently
  /// creates availability out of nothing.
  quantity   Decimal           @db.Decimal(18, 4)
  status     ReservationStatus @default(ACTIVE)

  /// What is holding the stock. Kept as a loose (type, id) pair rather than a
  /// foreign key per source, so a future quote or transfer can reserve without
  /// another migration. `invoice` is the only source today.
  sourceType String
  sourceId   String

  /// Optional expiry for ad-hoc holds. A reservation with no expiry is held
  /// until something explicitly consumes or releases it.
  expiresAt  DateTime?
  note       String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  releasedAt  DateTime?
  consumedAt  DateTime?

  company   Company  @relation(fields: [companyId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  // Availability is read on EVERY stock write, so this index is load-bearing.
  @@index([companyId, productId, locationId, status])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status])
}

// ------------------------------------------------------------
// THE HEART: STOCK AS AN EVENT LOG
// ------------------------------------------------------------

enum MovementType {
  PURCHASE     // stock in from a supplier          (+)
  SALE         // stock out to a customer           (-)
  RETURN_IN    // customer returned goods           (+)
  RETURN_OUT   // we returned goods to supplier     (-)
  ADJUSTMENT   // count correction, damage, theft   (+/-)
  TRANSFER_IN  // arrived from another location     (+)
  TRANSFER_OUT // sent to another location          (-)
}

/// What CONDITION a quantity of stock is in (P2-2, PRD §13).
///
/// The distinction that matters: stock can be OWNED without being SELLABLE.
/// A crushed box in the corner is still the company's property — it belongs in
/// the valuation and it must show up in a stocktake — but no order should ever
/// be filled from it.
///
///     On hand   = SUM(all movements)                    — what we own
///     Sellable  = SUM(movements WHERE status=AVAILABLE)  — what we may sell
///     Available = Sellable − Reserved                    — what's still free
///
/// Before this existed, damaged returns simply never entered stock. They were
/// noted on the return document and then vanished: not counted, not valued,
/// invisible to a stocktake — which meant the warehouse held goods the system
/// denied existed.
enum StockStatus {
  AVAILABLE  // good stock, sellable
  DAMAGED    // owned, not sellable — broken, crushed, spoiled
  QUARANTINE // held pending inspection; may become AVAILABLE or DAMAGED
  EXPIRED    // past its expiry date and written off
}

/// We NEVER store "current stock = 50" anywhere.
/// Every change is an immutable row here; current stock for a
/// product at a location = SUM(quantity) over its movements.
/// Rows are never updated or deleted — mistakes are corrected
/// by adding a compensating ADJUSTMENT. That's the audit trail.
model StockMovement {
  id          String       @id @default(cuid())
  companyId   String
  productId   String
  locationId  String
  type        MovementType
  /// SIGNED delta: +100 purchase, -3 sale, +2.5 kg received.
  /// Decimal(18,4) since P1-2 — see Product.precision for how many of those
  /// four places a given product is actually allowed to use.
  quantity    Decimal      @db.Decimal(18, 4)
  /// The condition this quantity is in (P2-2). Defaults to AVAILABLE, which
  /// is also what every pre-P2-2 row means — everything already in the ledger
  /// when this column arrived was ordinary sellable stock.
  ///
  /// Stock does NOT change status by having this column rewritten: movements
  /// are immutable (see the note on this model). Reclassifying goods writes a
  /// PAIR of ADJUSTMENT rows — one negative in the old status, one positive in
  /// the new — so the reclassification is itself a dated, attributed event and
  /// the history of "these units were quarantined for a week" survives.
  status      StockStatus  @default(AVAILABLE)
  unitCost    Decimal?     @db.Decimal(12, 2) // what we PAID, on incoming stock
  /// The weighted-average unit cost applied to THIS movement (P1-3).
  ///
  /// Stamped at the moment the movement is written and never touched again —
  /// which is what makes COGS honest. A sale in March keeps its March cost
  /// even after an expensive delivery in April moves the average. Because
  /// movements are immutable, history simply cannot be rewritten.
  ///
  /// COGS for a period = Σ |quantity| × costAtTime over its SALE movements.
  costAtTime  Decimal?     @db.Decimal(18, 6)
  batchNumber String?      // batch/lot code for perishables (F3)
  expiryDate  DateTime?    // when this batch expires (F3)
  reference   String?      // invoice no, PO no, reason for adjustment...
  note        String?
  transferId  String?      // links the OUT and IN rows of one transfer
  createdById String
  createdAt   DateTime     @default(now())
  // deliberately NO updatedAt — movements are immutable

  company   Company  @relation(fields: [companyId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  /// For batch-tracked products: which lots this movement touched, and how
  /// much of each. Empty for products that don't track batches.
  batchAllocations StockMovementBatch[]

  // The queries we'll run constantly — make them fast:
  @@index([companyId, productId, locationId])
  @@index([companyId, createdAt])
  // Sellable stock is now a filtered sum, run on every outgoing movement.
  @@index([companyId, productId, locationId, status])
}
