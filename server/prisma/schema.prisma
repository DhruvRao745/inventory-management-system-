// ============================================================
// Inventory — multi-tenant database schema
//
// THE ONE RULE: every model except Company carries `companyId`.
// A company (our paying customer) can only ever see rows with
// its own companyId. This is what makes one codebase safely
// serve many businesses.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// TENANT
// ------------------------------------------------------------

/// One customer business. Everything else hangs off this.
model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("INR") // ISO code: INR, USD, EUR...
  // Business details — shown on invoices (the "From" block). All optional so
  // existing companies keep working; the invoice simply omits blank lines.
  address   String? // full business address block
  phone     String?
  email     String?
  gstin        String? // GST registration number (India)
  pan          String? // PAN — the business tax ID
  sealText     String? // one line inside the round stamp, e.g. "For Demo Traders"
  invoiceTerms String? // terms & conditions printed on invoices (one per line)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  locations      Location[]
  categories     Category[]
  products       Product[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  customers      Customer[]
}

// ------------------------------------------------------------
// PEOPLE & ACCESS
// ------------------------------------------------------------

enum Role {
  ADMIN   // full control incl. settings & users
  MANAGER // manage products, approve adjustments
  STAFF   // record stock in/out
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String
  passwordHash String   // NEVER the password itself — bcrypt hash only
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  stockMovements StockMovement[] // movements this user recorded
  purchaseOrders PurchaseOrder[] // POs this user created
  invoices       Invoice[]       // invoices this user created

  // Same email may exist at two different companies,
  // but only once within one company:
  @@unique([companyId, email])
  @@index([companyId])
}

// ------------------------------------------------------------
// PLACES
// ------------------------------------------------------------

/// Warehouse, shop, or branch. Single-location companies
/// simply have one row here (created automatically at signup).
model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  stockMovements StockMovement[]
  invoices       Invoice[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ------------------------------------------------------------
// PARTNERS (who we buy from)
// ------------------------------------------------------------

/// A vendor we purchase stock from. Master data for Phase 2's
/// purchase orders; useful on its own as a contact book.
model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company         @relation(fields: [companyId], references: [id])
  purchaseOrders   PurchaseOrder[]
  preferredProducts Product[] // products that name this supplier as preferred

  @@unique([companyId, name])
  @@index([companyId])
}

// ------------------------------------------------------------
// PURCHASE ORDERS (buying stock — Phase 2)
// ------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT     // being built; editable
  ORDERED   // sent to supplier; locked, awaiting delivery
  PARTIAL   // some items received, some still pending
  RECEIVED  // every line fully received into stock
  CANCELLED // called off
}

/// A purchase order: what we're buying from one supplier. The number is
/// sequential PER COMPANY (PO-0001, PO-0002...), enforced by the unique
/// index; the service assigns the next value inside a transaction.
model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String
  supplierId   String
  number       Int // per-company sequence; display as PO-0001
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  expectedDate DateTime? // when we expect delivery (optional)
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  lines     PurchaseOrderLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, supplierId])
}

/// One line of a purchase order: a product, how many we're ordering, and
/// the agreed unit cost. Deleted/replaced freely while the PO is a DRAFT.
model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int // ordered quantity (always positive)
  receivedQty     Int     @default(0) // how many have arrived so far (Phase 3)
  unitCost        Decimal @db.Decimal(12, 2) // agreed price per unit

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ------------------------------------------------------------
// INVOICES (selling stock — Phase F4)
// ------------------------------------------------------------

enum InvoiceStatus {
  DRAFT     // being built; editable
  ISSUED    // finalised; stock deducted via SALE movements
  PAID      // customer has paid
  CANCELLED // called off (only before issuing)
}

/// A customer invoice. Number is sequential per company (INV-0001...).
/// Issuing deducts stock from `locationId` by writing SALE movements.
model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  number          Int // per-company sequence; display as INV-0001
  status          InvoiceStatus @default(DRAFT)
  customerId      String? // optional link to a saved customer (A1)
  customerName    String // snapshot — always kept even if unlinked
  customerPhone   String?
  customerAddress String?
  customerGstin   String? // buyer's GST — snapshot, for B2B invoices
  notes           String?
  taxRate         Decimal? @db.Decimal(5, 2) // % applied after discount (A3)
  discount        Decimal? @db.Decimal(12, 2) // flat amount off the subtotal (A3)
  locationId      String // where the sold stock comes from
  issuedAt        DateTime? // when it moved to ISSUED
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company   Company       @relation(fields: [companyId], references: [id])
  location  Location      @relation(fields: [locationId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id])
  lines     InvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId])
}

/// A saved customer — like a supplier, but for who we sell to (A1).
model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  invoices Invoice[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// One line: a product, quantity sold, and the price charged per unit.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// ------------------------------------------------------------
// WHAT WE STOCK
// ------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id                String   @id @default(cuid())
  companyId         String
  sku               String   // "stock keeping unit" — the code printed on the label
  barcode           String?  // scannable code (Code128); generated, unique per company (B1)
  name              String
  description       String?
  hsnCode           String?  // HSN/SAC tax code, printed per line on GST invoices
  categoryId          String?
  preferredSupplierId String? // usual vendor for this item (Phase 4)
  unit              String   @default("pcs") // pcs, kg, litre... configurable per product
  costPrice         Decimal  @default(0) @db.Decimal(12, 2) // what WE pay — Decimal, never Float, for money!
  sellingPrice      Decimal  @default(0) @db.Decimal(12, 2) // what the customer pays
  lowStockThreshold Int      @default(0) // alert when stock falls below this
  tracksBatch       Boolean  @default(false) // if true, stock-in captures batch + expiry (Phase F3)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  preferredSupplier  Supplier?           @relation(fields: [preferredSupplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       InvoiceLine[]

  // SKU must be unique within a company (two companies can both have "SKU-001")
  @@unique([companyId, sku])
  // Barcode also unique per company (NULLs allowed — many products may lack one)
  @@unique([companyId, barcode])
  @@index([companyId])
}

// ------------------------------------------------------------
// THE HEART: STOCK AS AN EVENT LOG
// ------------------------------------------------------------

enum MovementType {
  PURCHASE     // stock in from a supplier          (+)
  SALE         // stock out to a customer           (-)
  RETURN_IN    // customer returned goods           (+)
  RETURN_OUT   // we returned goods to supplier     (-)
  ADJUSTMENT   // count correction, damage, theft   (+/-)
  TRANSFER_IN  // arrived from another location     (+)
  TRANSFER_OUT // sent to another location          (-)
}

/// We NEVER store "current stock = 50" anywhere.
/// Every change is an immutable row here; current stock for a
/// product at a location = SUM(quantity) over its movements.
/// Rows are never updated or deleted — mistakes are corrected
/// by adding a compensating ADJUSTMENT. That's the audit trail.
model StockMovement {
  id          String       @id @default(cuid())
  companyId   String
  productId   String
  locationId  String
  type        MovementType
  quantity    Int          // SIGNED delta: +100 purchase, -3 sale
  unitCost    Decimal?     @db.Decimal(12, 2) // cost at the moment of movement (for valuation)
  batchNumber String?      // batch/lot code for perishables (F3)
  expiryDate  DateTime?    // when this batch expires (F3)
  reference   String?      // invoice no, PO no, reason for adjustment...
  note        String?
  transferId  String?      // links the OUT and IN rows of one transfer
  createdById String
  createdAt   DateTime     @default(now())
  // deliberately NO updatedAt — movements are immutable

  company   Company  @relation(fields: [companyId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  // The queries we'll run constantly — make them fast:
  @@index([companyId, productId, locationId])
  @@index([companyId, createdAt])
}
